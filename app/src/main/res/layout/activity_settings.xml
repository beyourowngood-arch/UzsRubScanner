<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="24dp" android:background="@color/surface">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="@string/settings" android:textColor="@color/text"
        android:textSize="28sp" android:textStyle="bold" />
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="24dp" android:hint="@string/rate_1">
        <com.google.android.material.textfield.TextInputEditText android:id="@+id/rate1"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:inputType="numberDecimal" />
    </com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:hint="@string/rate_2">
        <com.google.android.material.textfield.TextInputEditText android:id="@+id/rate2"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:inputType="numberDecimal" />
    </com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:hint="@string/rate_3">
        <com.google.android.material.textfield.TextInputEditText android:id="@+id/rate3"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:inputType="numberDecimal" />
    </com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.button.MaterialButton android:id="@+id/saveButton"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="20dp" android:text="@string/save" />
</LinearLayout>
